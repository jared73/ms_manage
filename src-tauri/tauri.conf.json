{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MS Manage",
  "version": "0.1.0",
  "identifier": "com.msmanage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MS Manage",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "MS Manage",
    "shortDescription": "MCP & Skill Manager",
    "longDescription": "MS Manage — MCP server 和 Skill 的统一管理工具。",
    "category": "DeveloperTool",
    "copyright": "",
    "homepage": "https://github.com/local/ms-manage",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "MS Manage"
      }
    }
  }
}
