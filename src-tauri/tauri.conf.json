{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MS Manage",
  "version": "1.7.0",
  "identifier": "com.msmanage.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1520",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MS Manage",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "MS Manage",
    "shortDescription": "MCP & Skill Manager",
    "longDescription": "MS Manage — MCP server 和 Skill 的统一管理工具。",
    "category": "DeveloperTool",
    "copyright": "",
    "homepage": "https://github.com/local/ms-manage",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCNjFFMEY0OUQxNEVEQTUKUldTbDdSU2Q5T0JoeTZWWG0reEp6TUxiSkJVM1VtaWNIczdoTFEwRDdFWkZWWDFYMUoxSG4xTDkK",
      "endpoints": [
        "http://www.73x.space:9100/Liuqingshan/ms-manage-releases/releases/download/v{{version}}/update.json"
      ]
    }
  }
}
